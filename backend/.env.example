MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=smart_library

SECRET_KEY=replace_with_strong_secret
JWT_SECRET=replace_with_strong_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

BACKEND_URL=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:5500
FRONTEND_LOGIN_PATH=/frontend/pages/login.html

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

FLASK_DEBUG=true
